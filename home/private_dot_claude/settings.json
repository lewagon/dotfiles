{
  "permissions": {
    "defaultMode": "default",
    "deny": [
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push *:main)",
      "Bash(git push * master)",
      "Bash(git push * master *)",
      "Bash(git push *:master)"
    ]
  },
  "model": "sonnet",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/yowfactor/.claude/hooks/skill-usage-tracker.py"
          }
        ]
      },
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/yowfactor/.claude/hooks/epic-handoff-nudge.py"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/yowfactor/.claude/hooks/epic-handoff-nudge.py"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "ruby-lsp@claude-plugins-official": true,
    "clangd-lsp@claude-plugins-official": true,
    "figma@claude-plugins-official": true,
    "slack@claude-plugins-official": true
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "outputStyle": "Learning",
  "tui": "fullscreen",
  "theme": "auto",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true
}
